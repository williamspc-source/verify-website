# ─────────────────────────────────────────────────────────────────────────────
# VERIFY Medico-Legal Solutions — environment
#
# Copy to `.env` and fill in. Anything marked REQUIRED IN PRODUCTION is checked
# in src/instrumentation.ts, which Next runs once before serving the first
# request: the process exits rather than starting, because each of these fails
# silently rather than loudly when missing.
#
# The check runs only when serving. `next build` sets NODE_ENV=production too,
# but building an artifact needs no deploy secrets, so it is skipped there
# (see src/utilities/assertProductionEnv.ts).
# ─────────────────────────────────────────────────────────────────────────────

# Postgres connection string. REQUIRED.
# Local dev uses the dedicated `verify_cms` database on Homebrew postgresql@15.
DATABASE_URL=postgresql://127.0.0.1:5432/verify_cms

# Encrypts JWT tokens and login sessions. REQUIRED.
# Changing it in production logs every admin user out.
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Public origin, no trailing slash. REQUIRED IN PRODUCTION.
# Used for CORS, absolute links, sitemaps and og:url — if it is wrong or unset,
# shared links and social previews point at localhost.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Validates draft-preview requests. REQUIRED IN PRODUCTION.
PREVIEW_SECRET=YOUR_SECRET_HERE

# Authenticates scheduled-publish cron jobs.
CRON_SECRET=YOUR_CRON_SECRET_HERE

# ── Email (SMTP) ─────────────────────────────────────────────────────────────
# Powers Form Builder notification emails — every enquiry, contact and
# newsletter signup — and admin password resets.
#
# SMTP_HOST is REQUIRED IN PRODUCTION. Leave it unset locally.
#
# When it is unset we do NOT use Payload's default console adapter — that one
# logs at info level and RESOLVES SUCCESSFULLY, so a notification that was never
# sent is indistinguishable from one that was. Instead every attempt is logged at
# ERROR level as:
#
#   [EMAIL NOT SENT] to="..." subject="..." — SMTP_HOST is not set ...
#
# The action that triggered the email still completes (the Form Submission is
# stored); only the notification is dropped. See src/email/emailNotSentAdapter.ts.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=VERIFY Medico-Legal Solutions
SMTP_FROM_ADDRESS=no-reply@vmls.com.au

# ── Local production-mode reproduction ───────────────────────────────────────
# `pnpm dev:prod` builds and then runs `next start`, which sets
# NODE_ENV=production — so the check above fires and the server exits, even
# though this is your laptop and not a deployment.
#
# Set this to 1 in your local `.env` to run it anyway. It does not disable
# anything except the refusal to start: a boxed banner is printed on every boot,
# and every email is still reported as [EMAIL NOT SENT].
#
# NEVER set this on the server. It is the only thing standing between a
# misconfigured deploy and months of silently discarded enquiries.
LOCAL_PROD_REPRO=

# ── Seed ─────────────────────────────────────────────────────────────────────
# Set to `true` to enable POST /next/seed-verify. Leave unset in production:
# the scaffold seed rewrites page parents (changing live URLs) and overwrites
# taxonomy copy from code fixtures.
ENABLE_SEED_ENDPOINT=
